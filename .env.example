# --- Structured database (PostgreSQL) ---
POSTGRES_USER=pcbuilder
POSTGRES_PASSWORD=pcbuilder
POSTGRES_DB=pcbuilder
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://pcbuilder:pcbuilder@localhost:5432/pcbuilder

# --- Vector database (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=pc_parts

# --- LLM provider ---
# One of: ollama | groq | custom (any OpenAI-compatible endpoint: LM Studio, OpenRouter, etc.)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Free cloud fallback (used when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Custom OpenAI-compatible endpoint (used when LLM_PROVIDER=custom)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# --- Embeddings ---
# One of: local | cloud
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Catalog (Open Icecat) ---
# Demo account works for single lookups. Index downloads need a free account: https://icecat.biz/registration
ICECAT_USERNAME=openIcecat-live
ICECAT_PASSWORD=

# --- App ---
APP_ENV=development
DEFAULT_CURRENCY=PHP
